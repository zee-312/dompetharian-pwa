# ==============================================================================
# DompetHarian (Android Offline-First Edition) — Environment Variables Example
# Author / Credit: Aravajordan
# Salin file ini menjadi .env.local dan isi kredensial yang sesuai.
# JANGAN PERNAH melakukan commit file .env.local ke repositori Git!
# ==============================================================================

# 1. URL Kanonik Aplikasi (Wajib HTTPS di produksi untuk PWA, Kamera, & GIS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Supabase Auth & PostgreSQL (Sumber Kebenaran Sinkronisasi)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Kunci Service Role HANYA untuk operasi admin di server (Jangan pernah diekspos ke klien!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 3. Google Identity Services — Penyimpanan Foto Struk di Google Drive Pengguna
# Hanya menggunakan scope non-sensitif: https://www.googleapis.com/auth/drive.file
# Tidak menggunakan Client Secret di server karena token diambil pendek-umur di memori browser.
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
